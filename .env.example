# ==============================================================================
# Eve Environment Configuration Example
# Copy this file to .env and provide your secret credentials.
# NEVER commit real credentials to source control!
# ==============================================================================

# Application & Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration (PostgreSQL with pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/eve

# Groq Cloud LLM Inference (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=30.0

# Jina AI Embeddings (https://jina.ai/embeddings)
JINA_API_KEY=jina_your_jina_api_key_here
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024

# Sentry Error Monitoring (https://sentry.io)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Comet Opik LLM Tracing (https://www.comet.com/site/products/opik/)
OPIK_API_KEY=your_opik_api_key_here
OPIK_WORKSPACE=default
OPIK_PROJECT_NAME=eve-assistant

# AWS Configuration (For production CloudWatch & deployments)
AWS_REGION=us-east-1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
